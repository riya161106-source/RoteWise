# =====================================================================
# ROUTEWISE ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT commit production secrets to version control.
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Cyber Security
JWT_SECRET=routewise_super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Management Systems (DBMS) - MySQL Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=routewise_db
DB_SSL=false
# Set DB_SSL=true when connecting to Azure Database for MySQL Flexible Server

# External APIs (Default public endpoints; override if using custom/enterprise instances)
PHOTON_API_URL=https://photon.komoot.io
OSRM_API_URL=https://router.project-osrm.org
