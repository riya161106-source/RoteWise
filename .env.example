# =====================================================================
# ROUTEWISE: ROOT ENVIRONMENT VARIABLES TEMPLATE
# Copy to backend/.env for local backend execution
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Cyber Security
JWT_SECRET=routewise_secure_jwt_secret_token_key_academic_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Management Systems (DBMS) - MySQL Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=routewise_db
DB_SSL=false
# Set DB_SSL=true when connecting to Azure Database for MySQL Flexible Server

# External APIs
PHOTON_API_URL=https://photon.komoot.io
OSRM_API_URL=https://router.project-osrm.org
